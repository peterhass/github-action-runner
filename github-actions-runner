#!/usr/bin/env bash
set -euo pipefail

docker_wrapper() {
    local option runner_host_state="" source target volume
    local -a args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--volume)
                [[ $# -ge 2 ]] || { printf '%s requires an argument.\n' "$1" >&2; return 2; }
                option="$1"
                volume="$2"
                shift 2
                ;;
            -v=*|--volume=*)
                option="${1%%=*}="
                volume="${1#*=}"
                shift
                ;;
            *)
                args+=("$1")
                shift
                continue
                ;;
        esac

        source="${volume%%:*}"
        target="${volume#*:}"
        target="${target%%:*}"
        if [[ "$target" == /__w && "$source" == */_work ]]; then
            runner_host_state="${source%/_work}"
        fi
        # The runner adds docker.sock automatically; reject any host API socket source.
        case "$source" in
            /run/docker.sock|/var/run/docker.sock|*/podman/podman.sock) continue ;;
        esac
        if [[ "$volume" == /runner:* || "$volume" == /runner/*:* ]]; then
            [[ -n "$runner_host_state" ]] || {
                printf 'Cannot translate runner mount without the /__w workspace mount.\n' >&2
                return 2
            }
            volume="${runner_host_state}${volume#/runner}"
        fi

        if [[ "$option" == *= ]]; then
            args+=("${option}${volume}")
        else
            args+=("$option" "$volume")
        fi
    done

    exec /usr/bin/podman --remote "${args[@]}"
}

if [[ "${0##*/}" == docker ]]; then
    docker_wrapper "$@"
fi

IMAGE="localhost/github-actions-runner:latest"
DATA_DIR="${HOME}/.local/share/github-actions-runner"
IMAGE_DIR="${DATA_DIR}/image"
STATE_DIR="${DATA_DIR}/state"
COUNT_FILE="${DATA_DIR}/runner-count"
BUILD_SERVICE="github-actions-runner-build.service"

usage() {
    cat <<EOF
Usage: ${0##*/} COMMAND

Commands:
  configure       Register the runner if it is not already registered.
  status          Show the runner service status.
  logs            Follow the runner service journal.
  update-hooks    Rebuild with the latest official container hooks.
  unregister      Remove the runner registration from GitHub.
  physical-core-count
                  Show the number of physical CPU cores.
EOF
}

physical_core_count() {
    local count
    command -v lscpu >/dev/null 2>&1 || {
        printf 'lscpu is required to detect physical CPU cores.\n' >&2
        return 1
    }
    count=$(LC_ALL=C lscpu --parse=CORE,SOCKET \
        | awk -F, '!/^#/ { print $1 "," $2 }' \
        | sort --unique \
        | wc --lines)
    [[ "$count" =~ ^[1-9][0-9]*$ ]] || {
        printf 'Could not determine the number of physical CPU cores.\n' >&2
        return 1
    }
    printf '%d\n' "$count"
}

runner_count() {
    local count
    if [[ -f "$COUNT_FILE" ]]; then
        IFS= read -r count < "$COUNT_FILE"
    else
        count=$(physical_core_count)
    fi
    [[ "$count" =~ ^[1-9][0-9]*$ ]] || {
        printf 'Invalid runner count: %s\n' "$count" >&2
        return 1
    }
    printf '%d\n' "$count"
}

runner_services() {
    local count instance
    count=$(runner_count)
    SERVICES=()
    for ((instance = 1; instance <= count; instance++)); do
        SERVICES+=("github-actions-runner@${instance}.service")
    done
}

container_initialise() {
    if [[ ! -x /runner/run.sh ]]; then
        cp -a /opt/actions-runner/. /runner/
    fi
}

container_run() {
    container_initialise
    cd /runner
    exec /runner/run.sh
}

container_configure() {
    local token
    container_initialise
    IFS= read -r token
    [[ -n "$token" ]] || { printf 'Registration token cannot be empty.\n' >&2; return 1; }
    cd /runner
    /runner/config.sh --unattended \
        --url "${RUNNER_URL:?RUNNER_URL is required}" \
        --token "$token" \
        --name "${RUNNER_NAME:-$(hostname)-${RUNNER_INSTANCE:?RUNNER_INSTANCE is required}}" \
        --work "${RUNNER_HOST_STATE:?RUNNER_HOST_STATE is required}/_work"
    unset token
}

container_unregister() {
    local token
    container_initialise
    IFS= read -r token
    [[ -n "$token" ]] || { printf 'Removal token cannot be empty.\n' >&2; return 1; }
    cd /runner
    /runner/config.sh remove --unattended --token "$token"
    unset token
}

configure() {
    local count instance state_dir url token
    local -a missing=()
    local -a podman_args

    count=$(runner_count)
    for ((instance = 1; instance <= count; instance++)); do
        state_dir="${STATE_DIR}-${instance}"
        mkdir -p "$state_dir"
        [[ -f "${state_dir}/.runner" ]] || missing+=("$instance")
    done
    if [[ ${#missing[@]} -eq 0 ]]; then
        printf 'All %d runners are already registered.\n' "$count"
        return
    fi

    read -r -p 'GitHub repository or organization URL: ' url
    [[ "$url" == https://github.com/* || "$url" == https://github.com ]] || {
        printf 'URL must use https://github.com.\n' >&2
        return 1
    }
    read -r -s -p 'GitHub runner registration token: ' token
    printf '\n'
    [[ -n "$token" ]] || { printf 'Registration token cannot be empty.\n' >&2; return 1; }

    for instance in "${missing[@]}"; do
        state_dir="${STATE_DIR}-${instance}"
        podman_args=(
            --rm --interactive
            --security-opt label=disable
            --volume "${state_dir}:/runner"
            --volume "${state_dir}:${state_dir}"
            --env "RUNNER_URL=${url}"
            --env "RUNNER_NAME=$(hostname)-${instance}"
            --env "RUNNER_INSTANCE=${instance}"
            --env "RUNNER_HOST_STATE=${state_dir}"
        )
        printf 'Registering runner %d of %d.\n' "$instance" "$count"
        printf '%s\n' "$token" | podman run "${podman_args[@]}" "$IMAGE" container-configure
    done
    unset token
}

status() {
    runner_services
    systemctl --user status "${SERVICES[@]}"
}

logs() {
    local service
    local -a journal_args=()
    runner_services
    for service in "${SERVICES[@]}"; do
        journal_args+=(--unit "$service")
    done
    journalctl --user "${journal_args[@]}" --follow
}

update_hooks() {
    local release hooks_version hooks_sha
    [[ -f "${IMAGE_DIR}/Containerfile" && -f "${IMAGE_DIR}/github-actions-runner" ]] || {
        printf 'Image sources are missing; run make install from the repository first.\n' >&2
        return 1
    }

    release=$(curl --fail --location --silent --show-error \
        https://api.github.com/repos/actions/runner-container-hooks/releases/latest)
    read -r hooks_version hooks_sha < <(python3 -c '
import json, sys
r = json.load(sys.stdin)
asset = next(a for a in r["assets"] if a["name"].startswith("actions-runner-hooks-docker-"))
print(r["tag_name"].removeprefix("v"), asset["digest"].removeprefix("sha256:"))
' <<<"$release")

    python3 - "${IMAGE_DIR}/Containerfile" "$hooks_version" "$hooks_sha" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text()
text, version_count = re.subn(r"^ARG HOOKS_VERSION=.*$", f"ARG HOOKS_VERSION={sys.argv[2]}", text, flags=re.M)
text, sha_count = re.subn(r"^ARG HOOKS_SHA256=.*$", f"ARG HOOKS_SHA256={sys.argv[3]}", text, flags=re.M)
if version_count != 1 or sha_count != 1:
    raise SystemExit("Could not update hook build arguments")
path.write_text(text)
PY
    systemctl --user restart "$BUILD_SERVICE"
    runner_services
    systemctl --user restart "${SERVICES[@]}"
}

unregister() {
    local instance state_dir token
    local -a registered=()
    local -a podman_args
    local -a services=()

    for state_dir in "${STATE_DIR}-"*; do
        [[ -f "${state_dir}/.runner" ]] || continue
        instance="${state_dir#"${STATE_DIR}-"}"
        [[ "$instance" =~ ^[1-9][0-9]*$ ]] || continue
        registered+=("$instance")
        services+=("github-actions-runner@${instance}.service")
    done
    if [[ ${#registered[@]} -eq 0 ]]; then
        printf 'No runners are registered.\n'
        return
    fi

    systemctl --user stop "${services[@]}" 2>/dev/null || true
    read -r -s -p 'GitHub runner removal token: ' token
    printf '\n'
    [[ -n "$token" ]] || { printf 'Removal token cannot be empty.\n' >&2; return 1; }
    for instance in "${registered[@]}"; do
        state_dir="${STATE_DIR}-${instance}"
        podman_args=(
            --rm --interactive
            --security-opt label=disable
            --volume "${state_dir}:/runner"
            --volume "${state_dir}:${state_dir}"
        )
        printf 'Unregistering runner %d.\n' "$instance"
        printf '%s\n' "$token" | podman run "${podman_args[@]}" "$IMAGE" container-unregister
    done
    unset token
}

main() {
    local command="${1:-}"
    [[ $# -le 1 ]] || { usage >&2; return 1; }
    case "$command" in
        configure) configure ;;
        status) status ;;
        logs) logs ;;
        update-hooks) update_hooks ;;
        unregister) unregister ;;
        physical-core-count) physical_core_count ;;
        container-run) container_run ;;
        container-configure) container_configure ;;
        container-unregister) container_unregister ;;
        -h|--help) usage ;;
        *)
            [[ -n "$command" ]] && printf 'Unknown command: %s\n' "$command" >&2
            usage >&2
            return 1
            ;;
    esac
}

main "$@"
